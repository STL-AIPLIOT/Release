# Python bytecode.
# 이 저장소는 한때 3.10 / 3.11 / 3.14 .pyc 를 동시에 담고 있었다. 실행할 때마다
# 재생성되고 .py 가 갖지 않은 정보는 하나도 없으면서, 커밋마다 diff 만 만든다.
__pycache__/
*.pyc
*.pyo

# 분석 도구 산출물.
# tools/*.py 가 만들어 내는 파생 결과다. 도구와 문서가 이미 git 에 있으므로
# 언제든 다시 만들 수 있고, 한 번 돌릴 때마다 40여 개 파일이 통째로 바뀐다.
# rl_trajectory_handoff/playback_cases/ 는 playback_cases/ 의 바이트 단위 복사본이라
# 같은 내용을 두 번 담게 된다.
#
#   analysis/predict_maneuver_comparison/  analyze_predict_maneuver.py
#   analysis/playback_cases/               export_playback_cases.py
#   analysis/rl_trajectory_handoff/        export_playback_cases.py --handoff
#   analysis/observation_consistency/      check_observation_consistency.py
#   analysis/bfm/, analysis/loss_patterns/, analysis/end_conditions/ 등
#
# 특정 시점 결과를 팀에 공유해야 하면 그때만 의도적으로 강제 추가한다.
#   git add -f analysis/rl_trajectory_handoff
analysis/*
# 손으로 쓴 문서는 유지한다. 도구가 만들지 않는다.
!analysis/rl_reward_handoff.md

# 분석용 임시 로그. PM_CSV_LOG 로 만드는 PredictManeuver CSV 와 BT stdout 덤프가
# 여기 쌓인다(docs/predict_maneuver_and_observation_validation.md §4).
logs/
*.stdout.log
bt_stdout.log

# 학습 산출물(artifacts/)은 여기 없다. 이 저장소는 팀이 편집하는
# student/ + experiments/ 슬라이스이고, train_rllib.py 와 run_local_dogfight.py
# 는 AIP_LIB\DogFightEnv\Release 에 있다. 그쪽에서 학습을 돌리게 되면 그때
# artifacts/ 를 추가한다.
artifacts/

# 에디터 / OS 가 만드는 파일. 저장소 내용과 무관하다.
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
